# 复制为 .env 并填入真实值；.env 已被 .gitignore 排除，不会进仓库
#
# 真实环境变量优先于本文件——GitHub Actions 里用 Secrets 即可，
# 本地开发用本文件，同一份代码两地都能跑。

# ---------- GitHub API ----------
# 可选。缺失时降级为匿名模式：60 req/h 且跳过趋势回溯。
# 只读公开仓库不需要任何 scope：
#   Fine-grained token → 仅勾 Public Repositories (read-only)
#   Classic token      → 一个 scope 都不勾
GITHUB_TOKEN=

# ---------- SMTP 邮件推送 ----------
# QQ 邮箱：设置 → 账号 → 开启 IMAP/SMTP 服务 → 生成 16 位授权码（不是登录密码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# 收件人，多个用英文逗号分隔
MAIL_TO=
